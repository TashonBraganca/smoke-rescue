                                  { "polyhaven": "dining_chair_02", "offset": [0.0, 0, -0.65], "yaw": 0 },
                                  { "polyhaven": "dining_chair_02", "offset": [0.55, 0, -0.65], "yaw": 0 },
                                  { "polyhaven": "dining_chair_02", "offset": [-0.55, 0, 0.65], "yaw": 180 },
