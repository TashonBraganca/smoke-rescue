    "floor_to_ceiling_bookshelves": [ { "polyhaven": "wooden_bookshelf_worn", "offset": [-0.9, 0, 0] },
                                      { "polyhaven": "wooden_bookshelf_worn", "offset": [0.0, 0, 0] },
                                      { "polyhaven": "wooden_bookshelf_worn", "offset": [0.9, 0, 0] } ],
    "wooden_desk_with_lamp":    [ { "polyhaven": "WoodenTable_01" }, { "polyhaven": "desk_lamp_arm_01", "offset": [0.4, "top", 0.1] } ],
