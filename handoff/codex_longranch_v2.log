/bin/zsh -lc "cat tools/score_ranches.py && cat tools/test_ranches.py && cat tools/headless/test.sh && ls tools/headless && rg -n 'roof|eaves|driveway|porch|footprint|Lawn' unity/SmokeRescue/Assets/SmokeRescue/Editor" in /Volumes/Tashon/opencv/wt_longranch
