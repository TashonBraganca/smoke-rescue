+def pnp_planar(partner: Keyframe, own: Keyframe, pairs, settings):
+    """Partner 3D body points against own 2D keypoint pixels with cv2.solvePnPRansac(SOLVEPNP_SQPNP), then the planar link.
+
+    PnP gives the own camera pose: optical = R X_partner + t. Through the own mount, body = B optical + offset, so the
+    partner-to-own body transform is M = B R, T = B t + offset; dyaw = atan2(M10, M00), (dx, dy) = T[:2]. Both body
+    frames are gravity aligned and share the floor, so a right pose has M close to a pure yaw (tilt is the angle of M's
+    z column from up) and T close to zero height (dz = T[2]).
+    Inliers are recounted with the final pose at place_pnp_reproj_px (and in front of the camera).
+    Returns (angle rad, t (2,), inlier mask, planar rmse m, tilt deg, dz m, reprojection rmse px) or None."""
+    if own.px is None or len(pairs) < 6:
+        return None
+    obj = partner.xyh[pairs[:, 0]].astype(np.float64)
+    img = own.px[pairs[:, 1]].astype(np.float64)
+    fx, fy, cx, cy = own.camera
+    K = np.array([[fx, 0.0, cx], [0.0, fy, cy], [0.0, 0.0, 1.0]])
+    thr = float(settings["place_pnp_reproj_px"])
+    cv2.setRNGSeed(int(settings["place_ransac_seed"]))
+    try:
+        ok, rvec, tvec, _ = cv2.solvePnPRansac(obj, img, K, None, iterationsCount=int(settings["place_ransac_iterations"]),
+                                               reprojectionError=thr, confidence=0.99, flags=cv2.SOLVEPNP_SQPNP)
+    except cv2.error:
+        return None
+    if not ok or not np.isfinite(rvec).all() or not np.isfinite(tvec).all():
+        return None
+    R = cv2.Rodrigues(rvec)[0]
+    proj = cv2.projectPoints(obj, rvec, tvec, K, None)[0].reshape(-1, 2)
+    reproj = np.hypot(*(proj - img).T)
+    mask = (reproj <= thr) & ((obj @ R.T + tvec.ravel())[:, 2] > 0)
+    if not mask.any():
+        return None
+    M = own.cam_to_body @ R
+    T = own.cam_to_body @ tvec.ravel() + own.body_offset
+    angle = math.atan2(M[1, 0], M[0, 0])
+    tilt = math.degrees(math.acos(float(np.clip(M[2, 2], -1.0, 1.0))))
+    planar = np.hypot(*(_apply(angle, T[:2], obj[:, :2]) - own.xyh[pairs[:, 1], :2]).T)
+    return (angle, T[:2].copy(), mask, float(np.sqrt(np.mean(planar[mask] ** 2))), tilt, float(T[2]),
+            float(np.sqrt(np.mean(reproj[mask] ** 2))))
+
