+def test_make_keyframe_keeps_own_pixels_off_the_radio():
+    settings = place.load_settings()
+    rng = np.random.default_rng(7)
+    rgb = np.repeat(rng.integers(0, 256, (480, 640, 1), dtype=np.uint8), 3, axis=2)
+    rgb = np.ascontiguousarray(np.kron(rgb[::4, ::4], np.ones((4, 4, 1), np.uint8)))
+    depth = np.full((480, 640), 3.0, np.float32)
+    fx, fy, cx, cy = UNITY_CAMERA
+    K = np.array([[fx, 0, cx], [0, fy, cy], [0, 0, 1.0]])
+    kf, n = place.make_keyframe(rgb, depth, K, settings)
+    assert kf is not None and n == len(kf) and kf.px.shape == (len(kf), 2) and kf.camera == UNITY_CAMERA
+    desc, xyh = place.extract_features(rgb, depth, K, settings)
+    desc2, xyh2, px = place.extract_features_px(rgb, depth, K, settings)
+    np.testing.assert_array_equal(desc, desc2)
+    np.testing.assert_array_equal(xyh, xyh2)
+    np.testing.assert_allclose(kf.px, px)
+    # The stored pixels are the projections of the stored (cm-quantised) points through the mount.
+    optical = (kf.xyh - kf.body_offset) @ kf.cam_to_body
+    proj = np.column_stack((fx * optical[:, 0] / optical[:, 2] + cx, fy * optical[:, 1] / optical[:, 2] + cy))
+    assert np.abs(proj - kf.px).max() < 1.5
+    raw = place.encode_payload(kf.desc, kf.xyh)
+    assert len(raw) == place.HEADER_BYTES + place.RECORD_BYTES * len(kf) and place.decode_payload(raw).px is None
