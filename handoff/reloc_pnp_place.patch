+# ---------------------------------------------------------------- place_fit switch (tools/reloc_compare.py)
+UNITY_CAMERA = (415.692, 415.692, 319.5, 239.5)
+LINK_YAW_DEG, LINK_T = 12.0, np.array([0.3, -0.4])
+
+
+def _far_scene(noise_m, seed=5, n=40):
+    """Partner and own views of n points 4 to 7 m ahead of the own robot, related by a known planar link. Own pixels
+    are exact projections through the configured mount; own depth is off along each ray by a random 0.5 to 1 times
+    noise_m with random sign, as long-range depth is. Returns (settings, partner payload keyframe, own keyframe)."""
+    import math
+    settings = place.load_settings()
+    rng = np.random.default_rng(seed)
+    B, offset = place.mount_camera_to_body(settings["mount"])
+    fx, fy, cx, cy = UNITY_CAMERA
+    own_true = np.column_stack((rng.uniform(-2, 2, n), rng.uniform(4, 7, n), rng.uniform(0.6, 2.4, n)))
+    optical = (own_true - offset) @ B                      # B is a rotation, so this is B^T (body - offset) per row
+    px = np.column_stack((fx * optical[:, 0] / optical[:, 2] + cx, fy * optical[:, 1] / optical[:, 2] + cy))
+    assert (optical[:, 2] > 0).all() and (px >= 0).all() and (px[:, 0] < 640).all() and (px[:, 1] < 480).all()
+    c, s = math.cos(math.radians(LINK_YAW_DEG)), math.sin(math.radians(LINK_YAW_DEG))
+    d = own_true[:, :2] - LINK_T                            # own = R(yaw) partner + t, so partner = R^T (own - t)
+    partner_xyh = np.column_stack((c * d[:, 0] + s * d[:, 1], -s * d[:, 0] + c * d[:, 1], own_true[:, 2]))
+    desc = rng.integers(0, 256, (n, 32), dtype=np.uint8)
+    err = rng.choice([-1.0, 1.0], n) * rng.uniform(0.5, 1.0, n) * noise_m
+    measured = optical * (1 + err / np.linalg.norm(optical, axis=1))[:, None]
+    own_xyh = place.decode_payload(place.encode_payload(desc, measured @ B.T + offset)).xyh
+    partner = place.decode_payload(place.encode_payload(desc, partner_xyh))
+    return settings, partner, place.Keyframe(desc, own_xyh, px, UNITY_CAMERA, B, offset)
+
+
+def _link_error(m):
+    return abs(m["dyaw_deg"] - LINK_YAW_DEG), float(np.hypot(m["dx_m"] - LINK_T[0], m["dy_m"] - LINK_T[1]))
+
+
+def test_place_fit_pnp_recovers_a_link_the_planar_fit_cannot_when_own_depth_is_noisy():
+    settings, partner, own = _far_scene(0.4)
+    pnp = place.match_keyframes(partner, [(0, own)], dict(settings, place_fit="pnp_sqpnp"))
+    assert pnp["matched"] and pnp["fit"] == "pnp_sqpnp" and pnp["inliers"] >= 38
+    yaw_err, t_err = _link_error(pnp)
+    assert yaw_err < 0.3 and t_err < 0.05 and pnp["tilt_deg"] < 0.5
+    planar = place.match_keyframes(partner, [(0, own)], dict(settings, place_fit="ransac_rigid"))
+    # Ignoring the switch would run PnP here: it would match with fit pnp_sqpnp and the right link.
+    if planar["matched"]:
+        assert planar["fit"] == "ransac_rigid" and max(_link_error(planar)[0] / 5, _link_error(planar)[1] / 0.5) > 1
+    else:
+        assert "rmse" in planar["reason"] and "PnP" not in planar["reason"]
+
+
+def test_place_fit_switch_selects_the_fit_on_clean_data_and_payloads_fall_back_to_planar():
+    settings, partner, own = _far_scene(0.0)
+    for fit in place.FITS:
+        m = place.match_keyframes(partner, [(0, own)], dict(settings, place_fit=fit))
+        assert m["matched"] and m["fit"] == fit and _link_error(m)[0] < 0.5 and _link_error(m)[1] < 0.05
+        assert ("tilt_deg" in m) == (fit == "pnp_sqpnp")
+    # A decoded payload has no own pixels, so even with the switch on the planar fit runs.
+    payload = place.decode_payload(place.encode_payload(own.desc, own.xyh))
+    assert payload.px is None
+    m = place.match_keyframes(partner, [(0, payload)], dict(settings, place_fit="pnp_sqpnp"))
+    assert m["matched"] and m["fit"] == "ransac_rigid"
+    # Settings from a parent process that predates place_fit keep the planar fit.
+    old = {k: v for k, v in settings.items() if not k.startswith(("place_fit", "place_pnp"))}
+    assert place.match_keyframes(partner, [(0, own)], old)["fit"] == "ransac_rigid"
+
+
+def test_place_database_match_follows_the_configured_fit():
