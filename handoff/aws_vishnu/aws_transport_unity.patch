+                bool refused = false;
+                try { Send(client, dir, 0.0); } catch (IOException) { refused = true; }
+                Check(refused, "upload failure hidden");
+                Send(client, dir, 0.0);
+                Check(handler.uri != prior && handler.batches.Last().Count(x => x.EndsWith(".png")) == 3, "new run or failed-upload cursor wrong");
