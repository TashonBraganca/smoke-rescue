@@ -0,0 +1,104 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Net;
+using System.Net.Http;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json.Linq;
+using SmokeRescue.Recording;
+public class RemoteRecordingFilesTests
+{
+    string previous;
+    [NUnit.Framework.SetUp] public void SaveEnvironment() => previous = Environment.GetEnvironmentVariable("SMOKE_REMOTE_FILES");
+    [NUnit.Framework.TearDown] public void RestoreEnvironment() => Environment.SetEnvironmentVariable("SMOKE_REMOTE_FILES", previous);
+    class Handler : HttpMessageHandler
+    {
+        public List<string[]> batches = new List<string[]>();
+        public bool missing, failUpload;
+        public string uri;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage req, CancellationToken token)
+        {
+            Check(req.RequestUri.AbsolutePath.StartsWith("/api/"), "lost API prefix");
+            if (req.Method == HttpMethod.Put)
+            {
+                if (failUpload) { failUpload = false; return new HttpResponseMessage(HttpStatusCode.InternalServerError); }
+                var bytes = await req.Content.ReadAsByteArrayAsync();
+                using (var zip = new ZipArchive(new MemoryStream(bytes), ZipArchiveMode.Read))
+                    batches.Add(zip.Entries.Select(e => e.FullName).ToArray());
+                var parts = req.RequestUri.AbsolutePath.Split('/');
+                uri = "run://" + parts[3] + "/" + parts[4];
+                return new HttpResponseMessage(HttpStatusCode.OK) { Content = new StringContent(new JObject { ["robot_dir"] = uri }.ToString()) };
+            }
+            var body = JObject.Parse(await req.Content.ReadAsStringAsync());
+            Check(body.Value<string>("robot_dir") == uri, "not a run URI");
+            Check(body["trace_path"] == null && body["debug_dir"] == null, "sent Mac output paths");
+            if (missing) { missing = false; return new HttpResponseMessage(HttpStatusCode.NotFound) { Content = new StringContent("upload first") }; }
+            return new HttpResponseMessage(HttpStatusCode.OK) { Content = new StringContent("{}") };
+        }
+    }
+    static void Check(bool condition, string why) { if (!condition) throw new Exception(why); }
+    static void Send(HttpClient client, string dir, double t, bool history = false)
+    {
+        var body = new JObject { ["robot_dir"] = dir, ["t"] = t, ["trace_path"] = "/mac/trace", ["debug_dir"] = "/mac/debug" };
+        if (history) body["frame_times"] = new JArray(0.0, .5, 1.0);
+        RemoteRecordingFiles.Post(client, "http://remote/api", "/robot/robot_A/step", body, CancellationToken.None).GetAwaiter().GetResult();
+    }
+    [NUnit.Framework.Test]
+    public void UploadAcknowledgementsHistoryRestartAndRunIdentity()
+    {
+        Environment.SetEnvironmentVariable("SMOKE_REMOTE_FILES", null);
+        Check(!RemoteRecordingFiles.Enabled("http://localhost:8080"), "localhost default on");
+        Check(!RemoteRecordingFiles.Enabled("http://127.0.0.1:8080"), "IPv4 loopback on");
