diff --git a/unity/SmokeRescue/Assets/SmokeRescue/Recording/RemoteRecordingFiles.cs b/unity/SmokeRescue/Assets/SmokeRescue/Recording/RemoteRecordingFiles.cs
new file mode 100644
--- /dev/null
+++ b/unity/SmokeRescue/Assets/SmokeRescue/Recording/RemoteRecordingFiles.cs
@@ -0,0 +1,197 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Net.Http;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json.Linq;
+
+namespace SmokeRescue.Recording
+{
+    /// <summary>Sensor-only ZIP uploads. Each recording gets a fresh id, even when the local folder is reused.</summary>
+    public static class RemoteRecordingFiles
+    {
+        static readonly object Gate = new object();
+        static readonly Dictionary<string, string> Runs = new Dictionary<string, string>();
+        static readonly Dictionary<string, Cursor> Cursors = new Dictionary<string, Cursor>();
+        static readonly string[] SmallFiles = { "camera.yaml", "thermal.yaml", "rgb.txt", "depth.txt", "thermal.txt", "lidar.txt", "decisions.jsonl" };
+        static long sequence;
+        sealed class Cursor
+        {
+            public readonly SemaphoreSlim upload = new SemaphoreSlim(1, 1);
+            public readonly HashSet<string> sent = new HashSet<string>();
+            public readonly Dictionary<string, string> hashes = new Dictionary<string, string>();
+            // A high-water mark alone misses history frames skipped by person scans. sent fills those gaps.
+            public double highestFrameTime = double.NegativeInfinity;
+            public long latestSnapshot;
+        }
+        sealed class Snapshot
+        {
+            public string directory, uri, endpoint;
+            public long order;
+            public Cursor cursor;
+            public JObject body;
+            public readonly Dictionary<string, byte[]> small = new Dictionary<string, byte[]>();
+            public readonly Dictionary<string, double> images = new Dictionary<string, double>();
+        }
+        public static bool Enabled(string url) => Environment.GetEnvironmentVariable("SMOKE_REMOTE_FILES") == "1" || !new Uri(url).IsLoopback;
+        public static void BeginRun(string root)
+        {
+            lock (Gate) { Runs.Clear(); Cursors.Clear(); Runs[Path.GetFullPath(root)] = Guid.NewGuid().ToString("N"); }
+        }
+        static string Run(string root)
+        {
+            lock (Gate)
+            {
+                if (!Runs.TryGetValue(root, out string id)) Runs[root] = id = Guid.NewGuid().ToString("N");
+                return id;
+            }
+        }
+        static string Hash(byte[] data)
+        {
+            using (var sha = SHA256.Create()) return Convert.ToBase64String(sha.ComputeHash(data));
+        }
+        static List<(double time, string file)> Index(string directory, string sensor, byte[] bytes)
+        {
+            var rows = new List<(double time, string file)>();
+            foreach (string line in Encoding.UTF8.GetString(bytes).Split('\n'))
+            {
+                if (string.IsNullOrWhiteSpace(line) || line.TrimStart().StartsWith("#")) continue;
+                string[] parts = line.Split((char[])null, StringSplitOptions.RemoveEmptyEntries);
+                if (parts.Length != 2 || !Regex.IsMatch(parts[1], "^" + sensor + @"/[0-9]+(?:\.[0-9]+)?\.png$"))
+                    throw new IOException("Invalid sensor index entry.");
+                double stamp = double.Parse(parts[0], CultureInfo.InvariantCulture);
+                if (double.IsNaN(stamp) || double.IsInfinity(stamp) || (rows.Count > 0 && stamp <= rows[rows.Count - 1].time))
+                    throw new IOException("Sensor timestamps must increase.");
+                rows.Add((stamp, parts[1]));
+            }
+            if (rows.Count == 0) throw new IOException("Empty " + sensor + " index in " + directory);
+            return rows;
+        }
+        static Snapshot Capture(string url, string path, JObject original)
+        {
+            var body = (JObject)original.DeepClone();
+            body.Remove("trace_path"); body.Remove("debug_dir");
+            var snapshot = new Snapshot { body = body, endpoint = url.TrimEnd('/'), order = Interlocked.Increment(ref sequence) };
+            string directory = original.Value<string>("robot_dir");
+            if (directory == null) return snapshot;  // commander logs use the server's writable default
+            directory = Path.GetFullPath(directory);
+            string root = Path.GetDirectoryName(directory), robot = Path.GetFileName(directory);
+            if (!Regex.IsMatch(robot, "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$")) throw new IOException("Invalid robot id.");
+            string run = Run(root), key = snapshot.endpoint + "|" + run + "|" + directory;
+            snapshot.directory = directory; snapshot.uri = "run://" + run + "/" + robot;
+            lock (Gate)
+            {
+                if (!Cursors.TryGetValue(key, out snapshot.cursor)) Cursors[key] = snapshot.cursor = new Cursor();
+            }
+            body["robot_dir"] = snapshot.uri;
+            foreach (string name in SmallFiles)
+            {
+                string file = Path.Combine(directory, name);
+                if (File.Exists(file)) snapshot.small[name] = File.ReadAllBytes(file);
+            }
+            // Freeze metadata before the first await. The async place client may continue while Unity records more.
+            string[] sensors = path.EndsWith("/match") || path.EndsWith("/export") ? new string[0]
+                : path.EndsWith("/integrate") ? new[] { "depth" }
+                : path.EndsWith("/keyframe") ? new[] { "rgb", "depth" } : new[] { "rgb", "depth", "thermal" };
+            double t = original.Value<double>("t");
+            var times = new List<double> { t };
+            if (original["frame_times"] is JArray history) times.AddRange(history.Values<double>());
+            if (times.Any(x => double.IsNaN(x) || double.IsInfinity(x))) throw new IOException("Invalid requested frame time.");
+            foreach (string sensor in sensors)
+            {
+                if (!snapshot.small.TryGetValue(sensor + ".txt", out byte[] index)) throw new IOException("Missing " + sensor + " index.");
+                var rows = Index(directory, sensor, index);
+                foreach (double stamp in times)
+                {
+                    var row = rows.OrderBy(r => Math.Abs(r.time - stamp)).ThenBy(r => r.time).First();
+                    snapshot.images[row.file] = row.time;
+                }
+            }
+            return snapshot;
+        }
+        static async Task<JObject> Upload(HttpClient http, Snapshot snapshot, CancellationToken token)
+        {
+            if (snapshot.cursor == null) return snapshot.body;
+            var cursor = snapshot.cursor;
+            await cursor.upload.WaitAsync(token).ConfigureAwait(false);
+            try
+            {
+                var files = new Dictionary<string, byte[]>();
+                foreach (var image in snapshot.images)
+                    if (!cursor.sent.Contains(image.Key)) files[image.Key] = File.ReadAllBytes(Path.Combine(snapshot.directory, image.Key));
+                var hashes = new Dictionary<string, string>();
+                if (snapshot.order >= cursor.latestSnapshot)
+                    foreach (var file in snapshot.small)
+                    {
+                        string hash = Hash(file.Value);
+                        if (!cursor.hashes.TryGetValue(file.Key, out string prior) || prior != hash)
+                        { files[file.Key] = file.Value; hashes[file.Key] = hash; }
+                    }
+                if (files.Count == 0) return snapshot.body;
+                using (var stream = new MemoryStream())
+                {
+                    using (var zip = new ZipArchive(stream, ZipArchiveMode.Create, true))
+                        foreach (var file in files)
+                            using (var entry = zip.CreateEntry(file.Key, CompressionLevel.NoCompression).Open())
+                                entry.Write(file.Value, 0, file.Value.Length);
+                    if (stream.Length > 64L * 1024 * 1024) throw new IOException("Sensor batch exceeds the server's 64 MiB limit.");
+                    stream.Position = 0;
+                    string[] id = snapshot.uri.Substring("run://".Length).Split('/');
+                    string endpoint = snapshot.endpoint + "/runs/" + id[0] + "/" + id[1] + "/files";
+                    using (var request = new HttpRequestMessage(HttpMethod.Put, endpoint))
+                    {
+                        request.Headers.Add("X-Recording-Source", snapshot.directory);
+                        request.Content = new StreamContent(stream);
+                        request.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
+                        using (var response = await http.SendAsync(request, token).ConfigureAwait(false))
+                        {
+                            if (!response.IsSuccessStatusCode) throw new IOException("Recording upload HTTP " + (int)response.StatusCode + ": " + await response.Content.ReadAsStringAsync().ConfigureAwait(false));
+                            var receipt = JObject.Parse(await response.Content.ReadAsStringAsync().ConfigureAwait(false));
+                            if (receipt.Value<string>("robot_dir") != snapshot.uri) throw new IOException("Unexpected recording upload receipt.");
+                        }
+                    }
+                }
+                // Advance only after the server acknowledges publication. A failed request can retry unchanged bytes.
+                foreach (var image in snapshot.images)
+                    if (files.ContainsKey(image.Key)) { cursor.sent.Add(image.Key); cursor.highestFrameTime = Math.Max(cursor.highestFrameTime, image.Value); }
+                foreach (var hash in hashes) cursor.hashes[hash.Key] = hash.Value;
+                cursor.latestSnapshot = Math.Max(cursor.latestSnapshot, snapshot.order);
+                return snapshot.body;
+            }
+            finally { cursor.upload.Release(); }
+        }
+        public static async Task<string> Post(HttpClient http, string url, string path, JObject body, CancellationToken token)
+        {
+            path = "/" + path.TrimStart('/');
+            // Capture runs synchronously on entry, before any wait lets the recorder rewrite an index.
+            var snapshot = Enabled(url) ? Capture(url, path, body) : null;
+            for (int attempt = 0; ; attempt++)
+            {
+                JObject request = snapshot == null ? body : await Upload(http, snapshot, token).ConfigureAwait(false);
+                using (var content = new StringContent(request.ToString(Newtonsoft.Json.Formatting.None), Encoding.UTF8, "application/json"))
+                using (var response = await http.PostAsync(url.TrimEnd('/') + path, content, token).ConfigureAwait(false))
+                {
+                    string text = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
+                    if (response.IsSuccessStatusCode) return text;
+                    // A restarted task has empty disk. Re-send this request's files once before reporting the error.
+                    if (attempt == 0 && snapshot?.cursor != null &&
+                        ((int)response.StatusCode == 404 || ((int)response.StatusCode == 400 && text.Contains("missing"))))
+                    {
+                        await snapshot.cursor.upload.WaitAsync(token).ConfigureAwait(false);
+                        try { snapshot.cursor.sent.Clear(); snapshot.cursor.hashes.Clear(); snapshot.cursor.latestSnapshot = 0; snapshot.cursor.highestFrameTime = double.NegativeInfinity; }
+                        finally { snapshot.cursor.upload.Release(); }
+                        continue;
+                    }
+                    throw new IOException("HTTP " + (int)response.StatusCode + " " + text);
+                }
+            }
+        }
+    }
+}
