<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><NoWarn>CS0436;CS0618;CS0649;CS0169;CS0414</NoWarn>
    <Src>$(MSBuildThisFileDirectory)../../unity/SmokeRescue/Assets/SmokeRescue</Src>
    <UnityResources>/Applications/Unity/Hub/Editor/6000.6.6f1/Unity.app/Contents/Resources</UnityResources>
