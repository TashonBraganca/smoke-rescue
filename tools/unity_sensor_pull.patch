+        [Test]
+        public void PullTransportSendsOnlyRequestedOriginalSensorBytes()
+        {
+            string folder = Path.Combine(Path.GetTempPath(), "smoke-pull-test-" + Guid.NewGuid());
+            Directory.CreateDirectory(Path.Combine(folder, "rgb"));
+            Directory.CreateDirectory(Path.Combine(folder, "depth"));
+            try
+            {
+                byte[] original = { 137, 80, 78, 71, 0, 255, 17, 42 };
+                File.WriteAllBytes(Path.Combine(folder, "depth", "1.000000.png"), original);
+                File.WriteAllBytes(Path.Combine(folder, "rgb", "1.000000.png"), new byte[] { 99 });
+                var files = SmokeRescue.Recording.SensorPullClient.RequestedFiles(folder, new[] { "depth/1.000000.png" });
+                Assert.That(files.Count, Is.EqualTo(1), "the server asked for depth only");
+                CollectionAssert.AreEqual(original, files["depth/1.000000.png"], "no image decoding, scaling or re-encoding");
+                Assert.Throws<InvalidDataException>(() => SmokeRescue.Recording.SensorPullClient.RequestedFiles(folder, new[] { "../robot_B/depth/1.png" }));
+                Assert.Throws<InvalidDataException>(() => SmokeRescue.Recording.SensorPullClient.RequestedFiles(folder, new[] { "oracle/survivors.json" }));
+                Assert.Throws<InvalidDataException>(() => SmokeRescue.Recording.SensorPullClient.RequestedFiles(folder, new[] { "depth/../../scene.json" }));
+            }
+            finally { Directory.Delete(folder, true); }
         }
 
